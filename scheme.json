{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "scheme.json",
    "title": "OpenPaster i18n schema",
    "description": "OpenPaster i18n schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "description": "The JSON schema for the OpenPaster i18n.",
            "type": ["string", "null"]
        },
        "app": {
            "type": "object",
            "description": "Application properties",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Application name",
                    "default": "OpenPaster"
                },
                "font_family": {
                    "type": "string",
                    "description": "Font family for this language",
                    "default": "-apple-system, sans-serif"
                }
            }
        },
        "paster_panel": {
            "type": "object",
            "description": "Paster panel properties",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Panel title",
                    "default": "Paster Panel"
                },
                "char_count_single": {
                    "type": "string",
                    "description": "Character count label, e.g. 1 char",
                    "default": "char"
                },
                "char_count_plural": {
                    "type": "string",
                    "description": "Character count label, e.g. 25 chars",
                    "default": "chars"
                }
            }
        },
        "record_type": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "text": {
                    "type": "string",
                    "description": "Text type label",
                    "default": "Text"
                },
                "html": {
                    "type": "string",
                    "description": "HTML type label",
                    "default": "HTML"
                },
                "image": {
                    "type": "string",
                    "description": "Image type label",
                    "default": "Image"
                },
                "file": {
                    "type": "string",
                    "description": "File type label",
                    "default": "File"
                }
            }
        },
        "menu": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "settings": {
                    "type": "string",
                    "description": "Settings menu item",
                    "default": "Settings"
                },
                "about": {
                    "type": "string",
                    "description": "About menu item",
                    "default": "About"
                },
                "help": {
                    "type": "string",
                    "description": "Help menu item",
                    "default": "Help"
                },
                "pause": {
                    "type": "string",
                    "description": "Pause menu item",
                    "default": "Pause"
                },
                "exit": {
                    "type": "string",
                    "description": "Exit menu item",
                    "default": "Exit"
                }
            }
        }
    }
}